# Get a free WalletConnect/Reown project id at https://cloud.reown.com
# Wallet connection (including MetaMask via browser injection) still works without
# it for local dev, but WalletConnect-based wallets need this set.
VITE_WALLETCONNECT_PROJECT_ID=

# The marketing site and the app are two separate builds/deployments (see
# vite.marketing.config.ts / vite.app.config.ts) that cross-link with plain
# <a> tags, not React Router — each needs to know the other's origin.
# Defaults (localhost:5173 / localhost:5174) work for local dev as-is.
VITE_MARKETING_URL=
VITE_APP_URL=
