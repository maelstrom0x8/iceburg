{
  "name": "iceburg-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:app": "vite --config vite.app.config.ts",
    "build": "npm run build:marketing && npm run build:app",
    "build:marketing": "tsc -b && vite build --config vite.marketing.config.ts",
    "build:app": "tsc -b && vite build --config vite.app.config.ts",
    "lint": "oxlint",
    "preview": "vite preview --outDir dist-marketing",
    "preview:app": "vite preview --config vite.app.config.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "@zerodev/ecdsa-validator": "^5.4.9",
    "@zerodev/sdk": "^5.5.10",
    "motion": "^13.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "viem": "^2.56.3",
    "wagmi": "^2.16.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "fast-check": "^4.9.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
